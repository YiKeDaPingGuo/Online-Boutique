{
  "dashboard": {
    "title": "K8s 集群资源监控",
    "tags": ["kubernetes", "cluster", "kube-state-metrics-v2"],
    "timezone": "browser",
    "style": "dark",
    "editable": true,
    "refresh": "30s",
    "time": { "from": "now-15m", "to": "now" },
    "templating": { "list": [] },
    "panels": [
      {
        "id": 1,
        "title": "集群节点数",
        "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "count(kube_node_info)", "legendFormat": "节点数", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "fixed" }, "unit": "none", "thresholds": { "steps": [ { "color": "#3274d9" } ] } } }
      },
      {
        "id": 2,
        "title": "总 Pod 数",
        "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "count(kube_pod_status_phase{phase=\"Running\"})", "legendFormat": "运行中", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "fixed" }, "unit": "none", "thresholds": { "steps": [ { "color": "#299c46" } ] } } }
      },
      {
        "id": 3,
        "title": "节点总 CPU",
        "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "sum(kube_node_status_capacity{resource=\"cpu\"})", "legendFormat": "CPU 核心", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "fixed" }, "unit": "short", "thresholds": { "steps": [ { "color": "#299c46" } ] } } }
      },
      {
        "id": 4,
        "title": "节点总内存",
        "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "sum(kube_node_status_capacity{resource=\"memory\"})", "legendFormat": "内存", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "fixed" }, "unit": "bytes", "thresholds": { "steps": [ { "color": "#3274d9" } ] } } }
      },
      {
        "id": 5,
        "title": "节点 CPU 使用率",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))", "legendFormat": "CPU 使用率", "refId": "A" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 30, "lineInterpolation": "smooth" } }
        },
        "options": { "legend": { "calcs": ["mean", "last", "max"], "displayMode": "table", "placement": "bottom" } }
      },
      {
        "id": 6,
        "title": "节点内存使用率",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "内存使用率", "refId": "A" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 30, "lineInterpolation": "smooth" } }
        },
        "options": { "legend": { "calcs": ["mean", "last", "max"], "displayMode": "table", "placement": "bottom" } }
      },
      {
        "id": 7,
        "title": "Pod 状态分布",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "count(kube_pod_status_phase{phase=\"Running\"}) by (phase)", "legendFormat": "Running", "refId": "A" },
          { "expr": "count(kube_pod_status_phase{phase=\"Pending\"}) by (phase)", "legendFormat": "Pending", "refId": "B" },
          { "expr": "count(kube_pod_status_phase{phase=\"Failed\"}) by (phase)", "legendFormat": "Failed", "refId": "C" },
          { "expr": "count(kube_pod_status_phase{phase=\"Succeeded\"}) by (phase)", "legendFormat": "Succeeded", "refId": "D" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "none", "custom": { "fillOpacity": 30, "lineInterpolation": "smooth" } }
        },
        "options": { "legend": { "calcs": ["mean", "last", "max"], "displayMode": "table", "placement": "bottom" } }
      },
      {
        "id": 8,
        "title": "Deployment 就绪/期望副本数",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "sum(kube_deployment_status_replicas_available{namespace=\"default\"}) by (namespace)", "legendFormat": "就绪 {{namespace}}", "refId": "A" },
          { "expr": "sum(kube_deployment_spec_replicas{namespace=\"default\"}) by (namespace)", "legendFormat": "期望 {{namespace}}", "refId": "B" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "none", "custom": { "fillOpacity": 30, "lineInterpolation": "smooth" } }
        },
        "options": { "legend": { "calcs": ["mean", "last", "max"], "displayMode": "table", "placement": "bottom" } }
      },
      {
        "id": 9,
        "title": "容器 CPU 请求与限制",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\",namespace=\"default\"}) by (namespace)", "legendFormat": "请求 {{namespace}}", "refId": "A" },
          { "expr": "sum(kube_pod_container_resource_limits{resource=\"cpu\",namespace=\"default\"}) by (namespace)", "legendFormat": "限制 {{namespace}}", "refId": "B" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "custom": { "fillOpacity": 30, "lineInterpolation": "smooth" } }
        },
        "options": { "legend": { "calcs": ["mean", "last", "max"], "displayMode": "table", "placement": "bottom" } }
      },
      {
        "id": 10,
        "title": "容器内存请求与限制",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\",namespace=\"default\"}) by (namespace)", "legendFormat": "请求 {{namespace}}", "refId": "A" },
          { "expr": "sum(kube_pod_container_resource_limits{resource=\"memory\",namespace=\"default\"}) by (namespace)", "legendFormat": "限制 {{namespace}}", "refId": "B" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "bytes", "custom": { "fillOpacity": 30, "lineInterpolation": "smooth" } }
        },
        "options": { "legend": { "calcs": ["mean", "last", "max"], "displayMode": "table", "placement": "bottom" } }
      },
      {
        "id": 11,
        "title": "节点负载 (1m/5m/15m)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "node_load1", "legendFormat": "负载1m", "refId": "A" },
          { "expr": "node_load5", "legendFormat": "负载5m", "refId": "B" },
          { "expr": "node_load15", "legendFormat": "负载15m", "refId": "C" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "none", "custom": { "fillOpacity": 30, "lineInterpolation": "smooth" } }
        },
        "options": { "legend": { "calcs": ["mean", "last", "max"], "displayMode": "table", "placement": "bottom" } }
      },
      {
        "id": 12,
        "title": "节点磁盘使用率",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
        "datasource": "Prometheus",
        "targets": [
          { "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}", "legendFormat": "磁盘使用率", "refId": "A" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 30, "lineInterpolation": "smooth" } }
        },
        "options": { "legend": { "calcs": ["mean", "last", "max"], "displayMode": "table", "placement": "bottom" } }
      }
    ],
    "schemaVersion": 27,
    "version": 1
  },
  "overwrite": true
}
